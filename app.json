{
  "expo": {
    "name": "Zap Wallet",
    "slug": "new-zap-wallet-exchange",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zapwallet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zapapp",
      "buildNumber": "48",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to provide enhanced security and fraud prevention for your transactions. Your location helps us verify your identity and protect your account."
      },
      "entitlements": {
        "com.apple.developer.applesignin": ["Default"],
        "com.apple.developer.associated-domains": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6045FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.zapapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/zapicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#6045FE",
          "dark": {
            "backgroundColor": "#6045FE"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera for photos and QR code scanning",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "extraGradleProperties": {
              "android.defaultConfig.missingDimensionStrategy": "react-native-camera, general"
            },
            "enableMinifyInReleaseBuilds": false
          }
        }
      ]
    ],
    "splash": {
      "image": "./assets/images/zapicon.png",
      "resizeMode": "cover",
      "imageWidth": 400,
      "imageHeight": 400,
      "backgroundColor": "#000000"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "024a9f16-05df-4af1-8688-c9552b3b89e8"
      }
    }
  }
}
